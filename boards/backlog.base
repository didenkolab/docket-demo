# Regenerated by docket.
filters:
  and:
    - or:
      - file.inFolder("ACME")
      - file.inFolder("BETA")
    - 'note.status_category == "todo"'
views:
  - type: table
    name: Backlog
    order:
      - note.key
      - note.title
      - note.type
      - note.priority
      - note.parent
      - note.labels
