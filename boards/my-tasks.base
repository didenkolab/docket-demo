filters:
  and:
    - or:
        - file.inFolder("ACME")
        - file.inFolder("BETA")
    - note.assignee == "agent/claude"
    - note.status_category != "done"
properties:
  note.key:
    displayName: Key
  note.title:
    displayName: Title
  note.status:
    displayName: Status
  note.priority:
    displayName: Priority
  note.updated:
    displayName: Updated
views:
  - type: table
    name: My tasks
    order:
      - key
      - title
      - status
      - priority
      - updated
